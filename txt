import { Renderer } from "./render";
import { ellipsePoint, generateTrack, followCoordinates } from "./tracking";
import { drawOrbit, drawReticle } from "./overlay";
import { OrbitalParams, Vec2 } from "./types";
import { TimelineController } from "./timeline";
const canvas = document.getElementById("gl") as HTMLCanvasElement;
const r = new Renderer(canvas);
const tl = new TimelineController();
function resize() { r.resize(window.innerWidth, window.innerHeight); }
window.addEventListener("resize", resize);
resize();
// Example orbital params — replace with your configuration when provided
const orbit: OrbitalParams = {
  center: [960, 540],
  a: 380,
  b: 220,
  theta: Math.PI * 0.15,
  omega: Math.PI / 6,  // 30 deg/s
  phase: 0
};
// Precompute an orbit path for overlay
const path = generateTrack(orbit, 0, 12, 0.02).map(p => p.pos);
// Coordinate follower state
let follower: Vec2 = path[0];
// Timeline hops demo — will be replaced by your assets
tl.setHops([
  { id: "seg-A", startT: 0, endT: 4 },
  { id: "seg-B", startT: 4, endT: 8 },
  { id: "seg-C", startT: 8, endT: 12 }
]);
tl.setStart(0);
tl.setSpeed(1);
let last = performance.now() / 1000;
function frame() {
  const now = performance.now() / 1000;
  const dt = Math.min(0.05, Math.max(0, now - last));
  last = now;
  tl.tick(dt);
  r.clear();
  // Environment skeleton: simple cross grid for spatial reference
  drawGrid();
  // Active orbit path
  drawOrbit(r, path);
  // Current target along orbit (as "tracking coordinates")
  const target = ellipsePoint(orbit, tl.time());
  follower = followCoordinates(follower, target, dt, 8);
  drawReticle(r, follower, 14);
  requestAnimationFrame(frame);
}
requestAnimationFrame(frame);
function drawGrid() {
  const step = 120;
  const pts: number[] = [];
  for (let x = 0; x <= window.innerWidth; x += step) {
    pts.push(x, 0, x, window.innerHeight);
  }
  for (let y = 0; y <= window.innerHeight; y += step) {
    pts.push(0, y, window.innerWidth, y);
  }
  const arr = new Float32Array(pts);
  r.drawLines(arr, [0.18, 0.28, 0.35], false);
}
