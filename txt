import { TimelineHop, TrackPoint } from "./types";
export class TimelineController {
  private hops: TimelineHop[] = [];
  private t0 = 0;
  private now = 0;
  private speed = 1.0;
  setHops(hops: TimelineHop[]) { this.hops = hops; }
  setStart(t: number) { this.t0 = t; this.now = t; }
  setSpeed(s: number) { this.speed = s; }
  tick(dt: number) { this.now += dt * this.speed; }
  // Filter track points within active hops (simple demo)
  activeWindow(points: TrackPoint[]): TrackPoint[] {
    if (this.hops.length === 0) return points;
    const t = this.now;
    const h = this.hops.find(h => t >= h.startT && t <= h.endT);
    if (!h) return [];
    return points.filter(p => p.t >= h.startT && p.t <= h.endT);
  }
  time() { return this.now; }
}
