import { vsBasic, fsSkeleton, fsOverlay } from "./shaders";
import { Vec2 } from "./types";
type Program = { prog: WebGLProgram; u: Record<string, WebGLUniformLocation> };
export class Renderer {
  gl: WebGL2RenderingContext;
  progSkeleton: Program;
  progOverlay: Program;
  vao: WebGLVertexArrayObject | null = null;
  vbo: WebGLBuffer | null = null;
  cap = 0;
  scale: Vec2 = [2/1920, -2/1080];   // world to NDC scale
  offset: Vec2 = [-1, 1];            // top-left origin world coords
  constructor(canvas: HTMLCanvasElement) {
    const gl = canvas.getContext("webgl2", { antialias: true, alpha: false });
    if (!gl) throw new Error("WebGL2 not supported");
    this.gl = gl;
    this.progSkeleton = this.makeProgram(vsBasic, fsSkeleton, ["u_scale","u_offset","u_color"]);
    this.progOverlay  = this.makeProgram(vsBasic, fsOverlay,  ["u_scale","u_offset","u_color"]);
    this.vao = gl.createVertexArray();
    this.vbo = gl.createBuffer();
    gl.bindVertexArray(this.vao);
    gl.bindBuffer(gl.ARRAY_BUFFER, this.vbo);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 8, 0);
    gl.bindVertexArray(null);
  }
  resize(w: number, h: number) {
    const gl = this.gl;
    gl.canvas.width = w;
    gl.canvas.height = h;
    gl.viewport(0, 0, w, h);
    // keep world units in pixels, map to NDC
    this.scale = [2/w, -2/h];
    this.offset = [-1, 1];
  }
  private makeShader(src: string, type: number) {
    const gl = this.gl;
    const sh = gl.createShader(type)!;
    gl.shaderSource(sh, src);
    gl.compileShader(sh);
    if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
      throw new Error(gl.getShaderInfoLog(sh) || "shader compile error");
    }
    return sh;
  }
  private makeProgram(vs: string, fs: string, uniforms: string[]): Program {
    const gl = this.gl;
    const p = gl.createProgram()!;
    gl.attachShader(p, this.makeShader(vs, gl.VERTEX_SHADER));
    gl.attachShader(p, this.makeShader(fs, gl.FRAGMENT_SHADER));
    gl.bindAttribLocation(p, 0, "a_pos");
    gl.linkProgram(p);
    if (!gl.getProgramParameter(p, gl.LINK_STATUS)) {
      throw new Error(gl.getProgramInfoLog(p) || "program link error");
    }
    const u: Record<string, WebGLUniformLocation> = {};
    uniforms.forEach(name => { const loc = gl.getUniformLocation(p, name); if (loc) u[name] = loc; });
    return { prog: p, u };
  }
  private ensureCapacity(f32: Float32Array) {
    const gl = this.gl;
    if (f32.length <= this.cap) return;
    this.cap = f32.length;
    gl.bindBuffer(gl.ARRAY_BUFFER, this.vbo);
    gl.bufferData(gl.ARRAY_BUFFER, f32, gl.DYNAMIC_DRAW);
  }
  drawLines(points: Float32Array, color: [number,number,number], overlay = false) {
    const gl = this.gl;
    const P = overlay ? this.progOverlay : this.progSkeleton;
    this.ensureCapacity(points);
    gl.bindVertexArray(this.vao);
    gl.bindBuffer(gl.ARRAY_BUFFER, this.vbo);
    gl.bufferSubData(gl.ARRAY_BUFFER, 0, points);
    gl.useProgram(P.prog);
    gl.uniform2f(P.u["u_scale"], this.scale[0], this.scale[1]);
    gl.uniform2f(P.u["u_offset"], this.offset[0], this.offset[1]);
    gl.uniform3f(P.u["u_color"], color[0], color[1], color[2]);
    gl.drawArrays(gl.LINE_STRIP, 0, points.length / 2);
    gl.bindVertexArray(null);
  }
  clear() {
    const gl = this.gl;
    gl.clearColor(0.03, 0.03, 0.05, 1);
    gl.clear(gl.COLOR_BUFFER_BIT);
  }
}
