import { Vec2, OrbitalParams, TrackPoint } from "./types";
export function ellipsePoint(p: OrbitalParams, t: number): Vec2 {
  const ang = p.phase + p.omega * t;
  const cosA = Math.cos(ang), sinA = Math.sin(ang);
  const xLocal = p.a * cosA;
  const yLocal = p.b * sinA;
  const c = Math.cos(p.theta), s = Math.sin(p.theta);
  const x = p.center[0] + xLocal * c - yLocal * s;
  const y = p.center[1] + xLocal * s + yLocal * c;
  return [x, y];
}
export function generateTrack(p: OrbitalParams, t0: number, t1: number, dt: number): TrackPoint[] {
  const out: TrackPoint[] = [];
  for (let t = t0; t <= t1 + 1e-6; t += dt) {
    out.push({ t, pos: ellipsePoint(p, t) });
  }
  return out;
}
// Follower with smoothing to match external coordinates
export function followCoordinates(current: Vec2, target: Vec2, dt: number, gain = 10): Vec2 {
  const k = 1 - Math.exp(-gain * dt);
  return [current[0] + (target[0] - current[0]) * k, current[1] + (target[1] - current[1]) * k];
}
