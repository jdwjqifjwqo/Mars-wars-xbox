import { Renderer } from "./render";
import { Vec2 } from "./types";
export function drawReticle(r: Renderer, p: Vec2, size = 12) {
  const [x, y] = p;
  const pts = new Float32Array([
    x - size, y, x - 3, y,
    x + 3, y, x + size, y,
    x, y - size, x, y - 3,
    x, y + 3, x, y + size
  ]);
  r.drawLines(pts, [0.9, 0.9, 0.2], true);
}
export function drawOrbit(r: Renderer, path: Vec2[], color = [0.2, 0.7, 1.0] as [number,number,number]) {
  const flat = new Float32Array(path.length * 2);
  for (let i = 0; i < path.length; i++) {
    flat[i*2] = path[i][0];
    flat[i*2+1] = path[i][1];
  }
  r.drawLines(flat, color, true);
}
